{
  "name": "templatemeva-store",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "typecheck": "tsc -b",
    "assets": "node generate-assets.js",
    "preview": "vite preview",
    "registry": "node tests/check-registry.cjs",
    "id:next": "node tools/next-id.cjs",
    "registry:sync": "node tools/register-product.cjs --sync",
    "registry:add": "node tools/register-product.cjs",
    "test": "npm run typecheck && npm run lint && npm run registry"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "lucide-react": "^1.52.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
